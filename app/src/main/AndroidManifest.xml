
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet access for checking app updates -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Biometric authentication -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Allow the user to install downloaded APK updates -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:label="HiPath Directory"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/AppTheme">

        <activity
            android:name=".SecurityActivity"
            android:exported="false" />

        <activity
            android:name=".ContactDetailActivity"
            android:exported="false" />

        <activity
            android:name=".AddEditActivity"
            android:exported="false" />

        <activity
            android:name=".SocietyActivity"
            android:exported="false" />

        <activity
            android:name=".CompanyPeopleActivity"
            android:exported="false" />

        <activity
            android:name=".PersonFormActivity"
            android:exported="false" />

        <activity
            android:name=".PersonDetailActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".ImportExportActivity"
            android:exported="false" />

        <activity
            android:name=".LockActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>
