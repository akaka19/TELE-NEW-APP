
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- SIP audio -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Biometric security -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- APK update installation, if used by the app -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:label="HiPath Directory"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/AppTheme">

        <activity
            android:name=".LockActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MainActivity" android:exported="false" />
        <activity android:name=".SIPActivity" android:exported="false" />
        <activity android:name=".SecurityActivity" android:exported="false" />
        <activity android:name=".AboutActivity" android:exported="false" />
        <activity android:name=".ContactDetailActivity" android:exported="false" />
        <activity android:name=".AddEditActivity" android:exported="false" />
        <activity android:name=".SocietyActivity" android:exported="false" />
        <activity android:name=".CompanyPeopleActivity" android:exported="false" />
        <activity android:name=".PersonFormActivity" android:exported="false" />
        <activity android:name=".PersonDetailActivity" android:exported="false" />
        <activity android:name=".ImportExportActivity" android:exported="false" />

    </application>

</manifest>
