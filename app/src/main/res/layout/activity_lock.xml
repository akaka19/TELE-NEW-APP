<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="28dp" android:background="#0B1020">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HIPATH" android:textColor="#35D7F2" android:textStyle="bold"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Directory" android:textColor="#F4F7FF" android:textStyle="bold" android:textSize="32sp" android:layout_marginTop="6dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Secure access to your telephone directory" android:textColor="#A8B3CA" android:gravity="center" android:layout_marginTop="12dp" android:layout_marginBottom="24dp"/>
<EditText android:id="@+id/pinInput" android:layout_width="match_parent" android:layout_height="54dp" android:hint="Enter PIN" android:inputType="numberPassword" android:maxLength="12" android:gravity="center" android:textColor="#FFFFFF" android:textColorHint="#8290AA" android:background="@drawable/bg_input" android:visibility="gone"/>
<Button android:id="@+id/pinButton" android:layout_width="match_parent" android:layout_height="54dp" android:text="Unlock with PIN" android:textAllCaps="false" android:backgroundTint="#35D7F2" android:textColor="#0B1020" android:visibility="gone"/>
<Button android:id="@+id/biometricButton" android:layout_width="match_parent" android:layout_height="54dp" android:text="Use fingerprint" android:textAllCaps="false" android:backgroundTint="#8B7CFF" android:textColor="#FFFFFF" android:layout_marginTop="10dp" android:visibility="gone"/>
<Button android:id="@+id/continueButton" android:layout_width="match_parent" android:layout_height="54dp" android:text="Continue" android:textAllCaps="false" android:backgroundTint="#35D7F2" android:textColor="#0B1020" android:visibility="gone"/>
<TextView android:id="@+id/lockError" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FF8A9A" android:gravity="center" android:layout_marginTop="14dp"/>
</LinearLayout>