<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0B1020"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CONTACT PROFILE" android:textColor="#35D7F2" android:textStyle="bold"/>
<TextView android:id="@+id/detailName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F4F7FF" android:textSize="28sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
<TextView android:id="@+id/detailPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#35D7F2" android:textSize="22sp" android:textStyle="bold" android:layout_marginTop="6dp" android:layout_marginBottom="18dp"/>
<LinearLayout android:id="@+id/detailFields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
<Button android:id="@+id/callButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="Call / Dial" android:textAllCaps="false" android:backgroundTint="#35D7F2" android:textColor="#0B1020" android:layout_marginTop="16dp"/>
<Button android:id="@+id/copyButton" android:layout_width="match_parent" android:layout_height="50dp" android:text="Copy Phone Number" android:textAllCaps="false" android:backgroundTint="#202A42" android:textColor="#F4F7FF" android:layout_marginTop="8dp"/>
<Button android:id="@+id/editButton" android:layout_width="match_parent" android:layout_height="50dp" android:text="Edit Contact" android:textAllCaps="false" android:backgroundTint="#8B7CFF" android:textColor="#FFFFFF" android:layout_marginTop="8dp"/>
<Button android:id="@+id/deleteButton" android:layout_width="match_parent" android:layout_height="50dp" android:text="Delete Contact" android:textAllCaps="false" android:backgroundTint="#612B42" android:textColor="#FFD8E0" android:layout_marginTop="8dp"/>
</LinearLayout></ScrollView>