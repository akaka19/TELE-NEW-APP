
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="#0B1020">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/menuButton"
            android:layout_width="46dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:text="☰"
            android:textSize="22sp"
            android:textAllCaps="false"
            android:backgroundTint="#202A42"
            android:textColor="#35D7F2" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HIPATH / SYSTEMS"
                android:textColor="#35D7F2"
                android:textStyle="bold"
                android:textSize="11sp" />

            <!-- Directory title hidden -->
            <TextView
                android:id="@+id/directoryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:visibility="gone" />

        </LinearLayout>

        <Button
            android:id="@+id/themeButton"
            android:layout_width="46dp"
            android:layout_height="48dp"
            android:text="☼"
            android:textAllCaps="false"
            android:backgroundTint="#202A42"
            android:textColor="#35D7F2" />

    </LinearLayout>

    <!-- Contact count summary -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_summary">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TELEPHONE EXTENSIONS"
                android:textColor="#C3F8FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/contactCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="▦"
            android:textColor="#35D7F2"
            android:textSize="30sp" />

    </LinearLayout>

    <!-- Search -->
    <EditText
        android:id="@+id/searchInput"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input"
        android:hint="Search any contact field..."
        android:singleLine="true"
        android:textColor="#F4F7FF"
        android:textColorHint="#8290AA"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:inputType="text" />

    <!-- Contacts heading -->
    <TextView
        android:id="@+id/contactsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Contacts"
        android:textColor="#F4F7FF"
        android:textSize="19sp"
        android:textStyle="bold"
        android:paddingTop="18dp"
        android:paddingBottom="10dp" />

    <!-- Contacts list and empty state -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/contactList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

        <TextView
            android:id="@+id/emptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="28dp"
            android:text="No contacts yet&#10;Tap Add Contact to create your first entry."
            android:textColor="#8290AA"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Add contact -->
    <Button
        android:id="@+id/addButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#35D7F2"
        android:text="+  Add Contact"
        android:textAllCaps="false"
        android:textColor="#0B1020"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
