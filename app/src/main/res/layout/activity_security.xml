<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0B1020"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Security &amp; Privacy" android:textColor="#F4F7FF" android:textSize="28sp" android:textStyle="bold"/>
<EditText android:id="@+id/newPinInput" android:layout_width="match_parent" android:layout_height="54dp" android:hint="Create a 4–12 digit PIN" android:inputType="numberPassword" android:maxLength="12" android:background="@drawable/bg_input" android:textColor="#FFFFFF" android:textColorHint="#8290AA" android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginTop="18dp"/>
<EditText android:id="@+id/confirmPinInput" android:layout_width="match_parent" android:layout_height="54dp" android:hint="Confirm PIN" android:inputType="numberPassword" android:maxLength="12" android:background="@drawable/bg_input" android:textColor="#FFFFFF" android:textColorHint="#8290AA" android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginTop="10dp"/>
<Button android:id="@+id/savePinButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="Save PIN" android:textAllCaps="false" android:backgroundTint="#35D7F2" android:textColor="#0B1020" android:layout_marginTop="12dp"/>
<Button android:id="@+id/biometricSetupButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="Enable Fingerprint Unlock" android:textAllCaps="false" android:backgroundTint="#8B7CFF" android:textColor="#FFFFFF" android:layout_marginTop="10dp"/>
<Button android:id="@+id/disableButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="Disable App Lock" android:textAllCaps="false" android:backgroundTint="#612B42" android:textColor="#FFD8E0" android:layout_marginTop="10dp"/>
<TextView android:id="@+id/securityStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#A8B3CA" android:layout_marginTop="18dp"/>
<Button android:id="@+id/securityDoneButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="Done" android:textAllCaps="false" android:backgroundTint="#202A42" android:textColor="#F4F7FF" android:layout_marginTop="16dp"/>
</LinearLayout></ScrollView>